# ============================================================
# CyberPulse — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- Database -----
DATABASE_URL="postgresql://username:password@localhost:5432/cyberpulse?schema=public"

# ----- NextAuth / Auth.js -----
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ----- OAuth Providers (optional – Phase 5) -----
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ----- Email Provider (Resend) -----
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@cyberpulse.io"

# ----- File Storage (S3-compatible) -----
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""           # For non-AWS providers (e.g. Cloudflare R2)

# ----- AI Provider (Phase 5) -----
# OPENAI_API_KEY=""
# GOOGLE_AI_API_KEY=""

# ----- Analytics (optional) -----
# NEXT_PUBLIC_GA_ID=""

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CyberPulse"
