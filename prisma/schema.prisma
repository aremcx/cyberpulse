// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
  MODERATOR
  USER
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ContentType {
  ARTICLE
  TUTORIAL
  NEWS
  RESEARCH
  THREAT_REPORT
  CASE_STUDY
  TOOL_REVIEW
  INTERVIEW
  CAREER
  SECURITY_AWARENESS
  OPINION
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum EventCategory {
  CONFERENCE
  WEBINAR
  CTF
  HACKATHON
  TRAINING
  MEETUP
  WORKSHOP
}

enum ThreatActorType {
  APT
  CYBERCRIME
  RANSOMWARE
  HACKTIVIST
  INSIDER
  NATION_STATE
}

enum MalwareType {
  RANSOMWARE
  TROJAN
  RAT
  INFOSTEALER
  BOTNET
  WORM
  ROOTKIT
  SPYWARE
  ADWARE
  OTHER
}

enum IndicatorType {
  DOMAIN
  IP_ADDRESS
  URL
  FILE_HASH_MD5
  FILE_HASH_SHA1
  FILE_HASH_SHA256
  EMAIL
  CVE
  OTHER
}

enum CvssVersion {
  V2
  V31
  V40
}

enum VulnerabilitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LabDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum NotificationType {
  ARTICLE_APPROVED
  ARTICLE_REJECTED
  ARTICLE_PUBLISHED
  COMMENT_REPLY
  NEW_COMMENT
  NEW_FOLLOWER
  COURSE_COMPLETED
  LAB_COMPLETED
  JOB_POSTED
  ANNOUNCEMENT
  SECURITY_REPORT_UPDATE
}

enum SecurityReportSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum SecurityReportStatus {
  SUBMITTED
  TRIAGED
  INVESTIGATING
  RESOLVED
  CLOSED
  DUPLICATE
}

enum NewsletterFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AuditAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_VERIFIED
  ROLE_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_DELETED
  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_PUBLISHED
  ARTICLE_DELETED
  ARTICLE_SUBMITTED
  ARTICLE_APPROVED
  ARTICLE_REJECTED
  COMMENT_DELETED
  COMMENT_REPORTED
  SECURITY_REPORT_UPDATED
  ADMIN_ACTION
  SETTINGS_CHANGED
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  image         String?
  password      String?   // hashed; null for OAuth-only accounts
  role          Role      @default(USER)
  bio           String?   @db.Text
  skills        String[]  @default([])
  certifications String[] @default([])
  website       String?
  twitter       String?
  linkedin      String?
  github        String?
  location      String?
  isSuspended   Boolean   @default(false)
  suspendedAt   DateTime?
  suspendedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  articles           Article[]        @relation("ArticleAuthor")
  editedArticles     Article[]        @relation("ArticleEditor")
  comments           Comment[]
  bookmarks          Bookmark[]
  likes              Like[]
  notifications      Notification[]   @relation("NotificationRecipient")
  sentNotifications  Notification[]   @relation("NotificationSender")
  following          Follow[]         @relation("Follower")
  followers          Follow[]         @relation("Following")
  courseProgress     CourseProgress[]
  labProgress        LabProgress[]
  newsletterSubscription NewsletterSubscriber?
  securityReports    SecurityReport[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

// ============================================================
// TAXONOMY
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  color       String?  // hex color for UI badge
  icon        String?  // lucide icon name
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryParent")
  articles     Article[]

  @@index([slug])
  @@index([parentId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles ArticleTag[]

  @@index([slug])
}

// ============================================================
// ARTICLES / CMS
// ============================================================

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?       @db.Text
  content         String        @db.Text
  contentJson     Json?         // TipTap JSON representation
  coverImage      String?
  coverImageAlt   String?
  authorId        String
  editorId        String?
  categoryId      String?
  contentType     ContentType   @default(ARTICLE)
  difficulty      DifficultyLevel?
  readingTime     Int?          // minutes
  status          ArticleStatus @default(DRAFT)
  featured        Boolean       @default(false)
  trending        Boolean       @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
  // SEO
  seoTitle        String?
  seoDescription  String?
  keywords        String[]      @default([])
  canonicalUrl    String?
  // Stats
  viewCount       Int           @default(0)
  likeCount       Int           @default(0)
  commentCount    Int           @default(0)
  bookmarkCount   Int           @default(0)
  // Metadata
  references      Json?         // array of {title, url}
  tableOfContents Json?         // generated ToC
  revisionNote    String?

  // Relations
  author    User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  editor    User?     @relation("ArticleEditor", fields: [editorId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
  tags      ArticleTag[]
  comments  Comment[]
  bookmarks Bookmark[]
  likes     Like[]
  revisions ArticleRevision[]

  // Full-text search
  searchVector Unsupported("tsvector")?

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([contentType])
  @@index([featured])
  @@index([publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  content   String   @db.Text
  contentJson Json?
  note      String?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ============================================================
// COMMENTS
// ============================================================

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  articleId String
  authorId  String
  parentId  String?
  isDeleted Boolean  @default(false)
  isApproved Boolean @default(true)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
  reports  CommentReport[]

  @@index([articleId])
  @@index([authorId])
  @@index([parentId])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  reporterId String
  reason    String
  createdAt DateTime @default(now())

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// ============================================================
// BOOKMARKS & LIKES
// ============================================================

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model Like {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

// ============================================================
// THREAT INTELLIGENCE (Phase 2 — schema ready)
// ============================================================

model ThreatActor {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  type        ThreatActorType
  aliases     String[]        @default([])
  description String?         @db.Text
  origin      String?         // country/region
  targets     String[]        @default([]) // sectors
  firstSeen   DateTime?
  lastSeen    DateTime?
  active      Boolean         @default(true)
  references  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  malware      ThreatActorMalware[]
  threatReports ThreatReport[]
}

model Malware {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  type        MalwareType
  aliases     String[]    @default([])
  description String?     @db.Text
  firstSeen   DateTime?
  active      Boolean     @default(true)
  references  Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  actors       ThreatActorMalware[]
  threatReports ThreatReportMalware[]
  indicators   Indicator[]
}

model ThreatActorMalware {
  threatActorId String
  malwareId     String

  threatActor ThreatActor @relation(fields: [threatActorId], references: [id], onDelete: Cascade)
  malware     Malware     @relation(fields: [malwareId], references: [id], onDelete: Cascade)

  @@id([threatActorId, malwareId])
}

model Indicator {
  id          String        @id @default(cuid())
  type        IndicatorType
  value       String
  description String?
  malwareId   String?
  reportId    String?
  confidence  Int?          // 0–100
  firstSeen   DateTime?
  lastSeen    DateTime?
  createdAt   DateTime      @default(now())

  malware     Malware?      @relation(fields: [malwareId], references: [id])
  report      ThreatReport? @relation(fields: [reportId], references: [id])

  @@index([type, value])
}

model ThreatReport {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  summary         String?     @db.Text
  description     String?     @db.Text
  threatActorId   String?
  targetSectors   String[]    @default([])
  targetGeos      String[]    @default([])
  techniques      Json?       // MITRE ATT&CK TTPs
  detectionGuidance String?   @db.Text
  mitigation      String?     @db.Text
  references      Json?
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  threatActor ThreatActor?          @relation(fields: [threatActorId], references: [id])
  malware     ThreatReportMalware[]
  indicators  Indicator[]
}

model ThreatReportMalware {
  threatReportId String
  malwareId      String

  threatReport ThreatReport @relation(fields: [threatReportId], references: [id], onDelete: Cascade)
  malware      Malware      @relation(fields: [malwareId], references: [id], onDelete: Cascade)

  @@id([threatReportId, malwareId])
}

// ============================================================
// VULNERABILITIES (Phase 2 — schema ready)
// ============================================================

model Vulnerability {
  id               String                @id @default(cuid())
  cveId            String?               @unique // e.g. CVE-2024-12345
  title            String
  slug             String                @unique
  description      String                @db.Text
  severity         VulnerabilitySeverity
  cvssScore        Float?
  cvssVersion      CvssVersion?
  cvssVector       String?
  affectedVendor   String?
  affectedProduct  String?
  affectedVersions String?
  publishedAt      DateTime?
  updatedAt        DateTime              @updatedAt
  createdAt        DateTime              @default(now())
  remediation      String?               @db.Text
  references       Json?
  isPoc            Boolean               @default(false)
  isKev            Boolean               @default(false) // CISA KEV flag
  kevDate          DateTime?

  @@index([cveId])
  @@index([severity])
  @@index([publishedAt])
}

// ============================================================
// TOOLS DIRECTORY (Phase 2 — schema ready)
// ============================================================

model Tool {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String   @db.Text
  logo         String?
  category     String   // maps to a predefined list
  platform     String[] @default([])
  isOpenSource Boolean  @default(false)
  website      String?
  documentation String?
  github       String?
  useCases     String[] @default([])
  skillLevel   DifficultyLevel?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

// ============================================================
// ACADEMY / COURSES (Phase 3 — schema ready)
// ============================================================

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  thumbnail   String?
  difficulty  DifficultyLevel
  duration    Int?         // minutes
  status      CourseStatus @default(DRAFT)
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules  CourseModule[]
  progress CourseProgress[]
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  title    String
  content  String @db.Text
  order    Int
  duration Int?   // minutes

  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model CourseProgress {
  userId     String
  courseId   String
  completed  Boolean  @default(false)
  percentage Int      @default(0)
  startedAt  DateTime @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

// ============================================================
// LABS (Phase 3 — schema ready)
// ============================================================

model Lab {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  difficulty  LabDifficulty
  objectives  Json?        // array of strings
  duration    Int?         // minutes
  points      Int          @default(10)
  category    String?
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progress LabProgress[]
}

model LabProgress {
  userId      String
  labId       String
  completed   Boolean  @default(false)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  score       Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([userId, labId])
}

// ============================================================
// JOBS (Phase 4 — schema ready)
// ============================================================

model Job {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  company         String
  companyLogo     String?
  description     String          @db.Text
  location        String?
  country         String?
  region          String?         // e.g. Africa, Nigeria
  workMode        WorkMode        @default(ONSITE)
  jobType         JobType         @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(MID)
  skills          String[]        @default([])
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?         @default("USD")
  applicationUrl  String?
  closingDate     DateTime?
  isActive        Boolean         @default(true)
  featured        Boolean         @default(false)
  postedById      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([country])
  @@index([region])
}

// ============================================================
// EVENTS (Phase 4 — schema ready)
// ============================================================

model Event {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String        @db.Text
  organizer       String?
  location        String?
  country         String?
  region          String?
  isOnline        Boolean       @default(false)
  startDate       DateTime
  endDate         DateTime?
  registrationUrl String?
  category        EventCategory @default(CONFERENCE)
  featured        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([startDate])
  @@index([category])
}

// ============================================================
// NEWSLETTER
// ============================================================

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  userId        String?  @unique
  name          String?
  // Topic preferences
  subNews       Boolean  @default(true)
  subThreatIntel Boolean @default(false)
  subVulns      Boolean  @default(false)
  subTutorials  Boolean  @default(false)
  subCareers    Boolean  @default(false)
  subEvents     Boolean  @default(false)
  unsubscribeToken String @unique @default(cuid())
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
}

model NewsletterCampaign {
  id          String   @id @default(cuid())
  subject     String
  content     String   @db.Text
  sentAt      DateTime?
  recipientCount Int   @default(0)
  openCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String
  message     String?
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([createdAt])
}

// ============================================================
// SECURITY VULNERABILITY DISCLOSURE
// ============================================================

model SecurityReport {
  id                String                 @id @default(cuid())
  reporterId        String?
  reporterName      String?
  reporterEmail     String?
  affectedComponent String
  severity          SecurityReportSeverity
  description       String                 @db.Text
  stepsToReproduce  String?                @db.Text
  status            SecurityReportStatus   @default(SUBMITTED)
  adminNotes        String?                @db.Text
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  reporter User? @relation(fields: [reporterId], references: [id])

  @@index([status])
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  resource   String?     // e.g. "article:clxxx"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// PLATFORM SETTINGS
// ============================================================

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
